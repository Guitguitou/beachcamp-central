<% content_for(:title, t("organizer.camps.index.title")) %>

<div class="flex items-center justify-between mb-8">
  <h1><%= t("organizer.camps.index.heading") %></h1>
  <%= render Ui::ButtonComponent.new(href: new_organizer_camp_path, size: "sm") { t("organizer.camps.index.create_camp") } %>
</div>

<% if @camps.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @camps.each do |camp| %>
      <%= render Ui::CardComponent.new(hoverable: true, padding: "p-5") do %>
        <a href="<%= organizer_camp_path(camp) %>" style="text-decoration:none; color:inherit; display:block;">
          <div class="flex items-center justify-between mb-3">
            <%= render Beachcamp::LevelBadgeComponent.new(level: camp.level) %>
            <%= render Ui::BadgeComponent.new(color: camp_status_color(camp)) { camp.status.humanize } %>
          </div>
          <h3 style="font-size:1.125rem; font-weight:var(--fw-bold); margin-bottom:var(--space-1);"><%= camp.title %></h3>
          <p style="font-size:var(--fs-sm); color:var(--neutral-500); margin-bottom:var(--space-3);">
            <%= camp.location %>, <%= camp.country %>
          </p>
          <div style="display:flex; justify-content:space-between; padding-top:var(--space-3); border-top:1px solid var(--neutral-200); font-size:var(--fs-sm);">
            <span style="color:var(--neutral-500);"><%= camp.start_date.strftime("%b %d") %> – <%= camp.end_date.strftime("%b %d") %></span>
            <span style="font-weight:var(--fw-bold);"><%= camp.registrations.active.count %>/<%= camp.max_participants %> <%= t("organizer.camps.index.spots") %></span>
          </div>
        </a>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="ds-empty">
    <div class="ds-empty__icon"><%= t("organizer.camps.index.empty_icon") %></div>
    <div class="ds-empty__title"><%= t("organizer.camps.index.empty_title") %></div>
    <p class="ds-empty__text"><%= t("organizer.camps.index.empty_text") %></p>
    <%= render Ui::ButtonComponent.new(href: new_organizer_camp_path) { t("organizer.camps.index.create_camp") } %>
  </div>
<% end %>
