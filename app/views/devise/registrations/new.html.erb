<% content_for(:title, t("devise_custom.registrations.title")) %>

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--neutral-50); padding:var(--space-8);">
  <div style="width:100%; max-width:480px;">
    <div style="text-align:center; margin-bottom:var(--space-8);">
      <a href="<%= root_path %>" style="font-size:1.5rem; font-weight:var(--fw-extrabold); color:var(--neutral-900); text-decoration:none;">
        🏐 <span class="gradient-text-sunset">BeachCamp</span>
      </a>
    </div>

    <%= render Ui::CardComponent.new(padding: "p-8") do %>
      <h2 style="text-align:center; margin-bottom:var(--space-2);"><%= t("devise_custom.registrations.heading") %></h2>
      <p style="text-align:center; color:var(--neutral-500); font-size:var(--fs-sm); margin-bottom:var(--space-6);"><%= t("devise_custom.registrations.subtitle") %></p>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render Ui::InputComponent.new(name: :first_name, label: t("devise_custom.registrations.first_name"), form: f, required: true, placeholder: t("devise_custom.registrations.first_name_placeholder")) %>
        <%= render Ui::InputComponent.new(name: :last_name, label: t("devise_custom.registrations.last_name"), form: f, required: true, placeholder: t("devise_custom.registrations.last_name_placeholder")) %>
        <%= render Ui::InputComponent.new(name: :email, label: t("devise_custom.registrations.email"), type: "email", form: f, required: true, placeholder: t("devise_custom.registrations.email_placeholder")) %>
        <%= render Ui::InputComponent.new(name: :password, label: t("devise_custom.registrations.password"), type: "password", form: f, required: true, helper: t("devise_custom.registrations.password_helper"), placeholder: t("devise_custom.registrations.password_placeholder")) %>
        <%= render Ui::InputComponent.new(name: :password_confirmation, label: t("devise_custom.registrations.confirm_password"), type: "password", form: f, required: true, placeholder: t("devise_custom.registrations.password_placeholder")) %>

        <div class="form-group">
          <label class="form-label"><%= t("devise_custom.registrations.role_label") %></label>
          <div class="flex gap-3">
            <label style="flex:1; display:flex; align-items:center; gap:var(--space-2); padding:var(--space-3) var(--space-4); border:1px solid var(--neutral-200); border-radius:var(--radius-md); cursor:pointer; font-size:var(--fs-sm);">
              <%= f.radio_button :role, "player", checked: true %> 🏐 <%= t("devise_custom.registrations.role_player") %>
            </label>
            <label style="flex:1; display:flex; align-items:center; gap:var(--space-2); padding:var(--space-3) var(--space-4); border:1px solid var(--neutral-200); border-radius:var(--radius-md); cursor:pointer; font-size:var(--fs-sm);">
              <%= f.radio_button :role, "organizer" %> 📋 <%= t("devise_custom.registrations.role_organizer") %>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label"><%= t("devise_custom.registrations.level_label") %></label>
          <%= f.select :level, User.levels.keys.map { |l| [l.humanize, l] }, {}, class: "form-input" %>
        </div>

        <%= f.submit t("devise_custom.registrations.submit"), class: "ds-btn ds-btn--primary ds-btn--lg", style: "width:100%;" %>
      <% end %>
    <% end %>

    <p style="text-align:center; margin-top:var(--space-6); font-size:var(--fs-sm); color:var(--neutral-500);">
      <%= t("devise_custom.registrations.has_account") %> <%= link_to t("devise_custom.registrations.log_in_link"), new_session_path(resource_name), style: "color:var(--sunset-500); font-weight:var(--fw-semibold);" %>
    </p>
  </div>
</div>
