<% content_for(:title, "#{@camp.title} — Admin BeachCamp") %>
<% content_for(:breadcrumb) { (link_to("Camps", admin_camps_path) + " / #{@camp.title}").html_safe } %>

<% status_styles = {
  "draft"     => { bg: "var(--neutral-100)", color: "var(--neutral-700)", label: "Brouillon" },
  "published" => { bg: "var(--growth-100)",  color: "var(--growth-700)",  label: "Publié" },
  "full"      => { bg: "var(--ocean-100)",   color: "var(--ocean-700)",   label: "Complet" },
  "cancelled" => { bg: "var(--error-100)",   color: "var(--error-700)",   label: "Annulé" },
} %>
<% st = status_styles[@camp.status] || { bg: "var(--neutral-100)", color: "var(--neutral-600)", label: @camp.status } %>

<%# En-tête %>
<div class="flex items-start justify-between mb-6" style="flex-wrap:wrap; gap:var(--space-4);">
  <div class="flex items-center gap-3">
    <%= link_to "← Camps", admin_camps_path, class: "ds-btn ds-btn--outline ds-btn--sm" %>
    <div>
      <div class="flex items-center gap-3">
        <h1 class="mb-0"><%= @camp.title %></h1>
        <span style="font-size:11px; font-weight:var(--fw-semibold); background:<%= st[:bg] %>; color:<%= st[:color] %>; padding:4px 12px; border-radius:999px; text-transform:uppercase; letter-spacing:0.06em;">
          <%= st[:label] %>
        </span>
        <% if @camp.featured? %>
          <span style="font-size:11px; font-weight:var(--fw-semibold); background:var(--sunset-100); color:var(--sunset-700); padding:4px 12px; border-radius:999px;">⭐ Mis en avant</span>
        <% end %>
      </div>
      <p class="text-muted" style="font-size:var(--fs-sm); margin-top:2px;"><%= @camp.location %>, <%= @camp.country %></p>
    </div>
  </div>

  <%# Actions de statut %>
  <div class="flex gap-2" style="flex-wrap:wrap;">
    <%= link_to "Modifier", edit_admin_camp_path(@camp), class: "ds-btn ds-btn--outline ds-btn--md" %>

    <% if @camp.draft? || @camp.cancelled? %>
      <%= button_to "Publier", publish_admin_camp_path(@camp),
        method: :patch,
        class: "ds-btn ds-btn--primary ds-btn--md",
        style: "background:var(--growth-600);border-color:var(--growth-600);" %>
    <% end %>
    <% if @camp.published? || @camp.full? %>
      <%= button_to "Remettre en brouillon", set_draft_admin_camp_path(@camp),
        method: :patch,
        class: "ds-btn ds-btn--outline ds-btn--md" %>
      <%= button_to "Annuler le camp", cancel_admin_camp_path(@camp),
        method: :patch,
        data: { turbo_confirm: "Annuler ce camp ? Les participants seront impactés." },
        class: "ds-btn ds-btn--md",
        style: "background:var(--error-50);color:var(--error-700);border:1px solid var(--error-200);" %>
    <% end %>

    <%= link_to "Supprimer", admin_camp_path(@camp),
      data: { turbo_method: :delete, turbo_confirm: "Supprimer définitivement \"#{@camp.title}\" ? Cette action est irréversible." },
      class: "ds-btn ds-btn--sm",
      style: "background:var(--error-50);color:var(--error-700);border:1px solid var(--error-200); align-self:center;" %>
  </div>
</div>

<%# Deux colonnes: infos + stats %>
<div style="display:grid; grid-template-columns: 2fr 1fr; gap:var(--space-6); margin-bottom:var(--space-6); align-items:start;">

  <%# Détails %>
  <%= render Ui::CardComponent.new(padding: "p-6") do %>
    <h3 class="mb-4" style="font-size:var(--fs-base);">Détails</h3>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:var(--space-4);">
      <div>
        <div style="font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:0.07em; color:var(--neutral-400); font-weight:var(--fw-semibold); margin-bottom:4px;">Organisateur</div>
        <div style="font-size:var(--fs-sm); font-weight:var(--fw-semibold);"><%= @camp.organizer.full_name %></div>
        <div style="font-size:var(--fs-xs); color:var(--neutral-500);"><%= @camp.organizer.email %></div>
      </div>
      <div>
        <div style="font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:0.07em; color:var(--neutral-400); font-weight:var(--fw-semibold); margin-bottom:4px;">Coach</div>
        <% if @camp.coach %>
          <div style="font-size:var(--fs-sm); font-weight:var(--fw-semibold);"><%= @camp.coach.full_name %></div>
          <div style="font-size:var(--fs-xs); color:var(--neutral-500);"><%= @camp.coach.email %></div>
        <% else %>
          <div style="font-size:var(--fs-sm); color:var(--neutral-400);">—</div>
        <% end %>
      </div>
      <div>
        <div style="font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:0.07em; color:var(--neutral-400); font-weight:var(--fw-semibold); margin-bottom:4px;">Dates</div>
        <div style="font-size:var(--fs-sm);">
          <%= @camp.start_date ? I18n.l(@camp.start_date, format: :long) : "—" %><br>
          <span style="color:var(--neutral-500);">→ <%= @camp.end_date ? I18n.l(@camp.end_date, format: :long) : "—" %></span>
        </div>
      </div>
      <div>
        <div style="font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:0.07em; color:var(--neutral-400); font-weight:var(--fw-semibold); margin-bottom:4px;">Niveau</div>
        <div style="font-size:var(--fs-sm);"><%= @camp.level.humanize %></div>
      </div>
      <div>
        <div style="font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:0.07em; color:var(--neutral-400); font-weight:var(--fw-semibold); margin-bottom:4px;">Prix</div>
        <div style="font-size:var(--fs-sm); font-weight:var(--fw-semibold);"><%= @camp.price_display %> <%= @camp.currency %></div>
      </div>
      <div>
        <div style="font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:0.07em; color:var(--neutral-400); font-weight:var(--fw-semibold); margin-bottom:4px;">Créé le</div>
        <div style="font-size:var(--fs-sm);"><%= I18n.l(@camp.created_at.to_date, format: :long) %></div>
      </div>
    </div>
    <% if @camp.description.present? %>
      <div style="margin-top:var(--space-4); padding-top:var(--space-4); border-top:1px solid var(--neutral-100);">
        <div style="font-size:var(--fs-xs); text-transform:uppercase; letter-spacing:0.07em; color:var(--neutral-400); font-weight:var(--fw-semibold); margin-bottom:var(--space-2);">Description</div>
        <p style="font-size:var(--fs-sm); color:var(--neutral-700); white-space:pre-line;"><%= @camp.description %></p>
      </div>
    <% end %>
  <% end %>

  <%# Capacité %>
  <%= render Ui::CardComponent.new(padding: "p-6") do %>
    <h3 class="mb-4" style="font-size:var(--fs-base);">Capacité</h3>
    <% total = @camp.max_participants
       confirmed = @camp.registrations.confirmed.count
       pending   = @camp.registrations.pending.count
       pct = total > 0 ? (confirmed.to_f / total * 100).round : 0 %>
    <div style="margin-bottom:var(--space-4);">
      <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
        <span style="font-size:var(--fs-sm); color:var(--neutral-600);">Confirmés</span>
        <span style="font-size:var(--fs-sm); font-weight:var(--fw-bold);"><%= confirmed %> / <%= total %></span>
      </div>
      <div style="background:var(--neutral-100); border-radius:999px; height:8px; overflow:hidden;">
        <div style="background:var(--growth-500); height:100%; width:<%= pct %>%; border-radius:999px; transition:width 0.3s;"></div>
      </div>
      <div style="font-size:var(--fs-xs); color:var(--neutral-400); margin-top:4px;"><%= pct %>% rempli</div>
    </div>
    <div style="display:flex; flex-direction:column; gap:var(--space-2);">
      <div style="display:flex; justify-content:space-between; padding:var(--space-2) var(--space-3); background:var(--growth-50); border-radius:var(--radius-sm);">
        <span style="font-size:var(--fs-xs); color:var(--growth-700);">Confirmés</span>
        <span style="font-size:var(--fs-sm); font-weight:var(--fw-bold); color:var(--growth-700);"><%= confirmed %></span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:var(--space-2) var(--space-3); background:var(--sunset-50); border-radius:var(--radius-sm);">
        <span style="font-size:var(--fs-xs); color:var(--sunset-700);">En attente</span>
        <span style="font-size:var(--fs-sm); font-weight:var(--fw-bold); color:var(--sunset-700);"><%= pending %></span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:var(--space-2) var(--space-3); background:var(--neutral-50); border-radius:var(--radius-sm);">
        <span style="font-size:var(--fs-xs); color:var(--neutral-500);">Places restantes</span>
        <span style="font-size:var(--fs-sm); font-weight:var(--fw-bold);"><%= [total - confirmed, 0].max %></span>
      </div>
      <div style="display:flex; justify-content:space-between; padding:var(--space-2) var(--space-3); background:var(--neutral-50); border-radius:var(--radius-sm);">
        <span style="font-size:var(--fs-xs); color:var(--neutral-500);">Min. requis</span>
        <span style="font-size:var(--fs-sm); font-weight:var(--fw-bold);"><%= @camp.min_participants %></span>
      </div>
    </div>
  <% end %>
</div>

<%# Inscriptions %>
<%= render Ui::CardComponent.new(padding: "p-0") do %>
  <div style="padding:var(--space-5) var(--space-6) var(--space-4); border-bottom:1px solid var(--neutral-100); display:flex; align-items:center; justify-content:space-between;">
    <h3 style="font-size:var(--fs-base); font-weight:var(--fw-bold); margin:0;">Inscriptions (<%= @registrations.count %>)</h3>
  </div>
  <div style="overflow-x:auto;">
    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr style="background:var(--neutral-50); border-bottom:1px solid var(--neutral-200);">
          <th style="padding:var(--space-3) var(--space-4); text-align:left; font-size:var(--fs-xs); color:var(--neutral-500); font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.05em;">Participant</th>
          <th style="padding:var(--space-3) var(--space-4); text-align:left; font-size:var(--fs-xs); color:var(--neutral-500); font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.05em;">Niveau</th>
          <th style="padding:var(--space-3) var(--space-4); text-align:left; font-size:var(--fs-xs); color:var(--neutral-500); font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.05em;">Inscrit le</th>
          <th style="padding:var(--space-3) var(--space-4); text-align:left; font-size:var(--fs-xs); color:var(--neutral-500); font-weight:var(--fw-semibold); text-transform:uppercase; letter-spacing:0.05em;">Statut</th>
          <th style="padding:var(--space-3) var(--space-4);"></th>
        </tr>
      </thead>
      <tbody>
        <% @registrations.each do |reg| %>
          <% reg_styles = {
            "pending"   => { bg: "var(--sunset-100)",  color: "var(--sunset-700)",  label: "En attente" },
            "confirmed" => { bg: "var(--growth-100)",  color: "var(--growth-700)",  label: "Confirmée" },
            "cancelled" => { bg: "var(--neutral-100)", color: "var(--neutral-500)", label: "Annulée" },
          }
          rs = reg_styles[reg.status] || { bg: "var(--neutral-100)", color: "var(--neutral-500)", label: reg.status } %>
          <tr style="border-bottom:1px solid var(--neutral-100);">
            <td style="padding:var(--space-3) var(--space-4);">
              <div class="flex items-center gap-3">
                <% if reg.user.avatar.attached? %>
                  <%= image_tag reg.user.avatar.variant(resize_to_fill: [32, 32]),
                    style: "width:32px;height:32px;border-radius:50%;object-fit:cover;" %>
                <% else %>
                  <div style="width:32px;height:32px;background:var(--gradient-ocean);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:11px;font-weight:var(--fw-bold);">
                    <%= reg.user.first_name[0] %><%= reg.user.last_name[0] %>
                  </div>
                <% end %>
                <div>
                  <div style="font-weight:var(--fw-semibold); font-size:var(--fs-sm);"><%= reg.user.full_name %></div>
                  <div style="font-size:var(--fs-xs); color:var(--neutral-500);"><%= reg.user.email %></div>
                </div>
              </div>
            </td>
            <td style="padding:var(--space-3) var(--space-4); font-size:var(--fs-sm); color:var(--neutral-600);">
              <%= reg.user.level.humanize %>
            </td>
            <td style="padding:var(--space-3) var(--space-4); font-size:var(--fs-xs); color:var(--neutral-500);">
              <%= I18n.l(reg.created_at.to_date, format: :short) %>
            </td>
            <td style="padding:var(--space-3) var(--space-4);">
              <span style="font-size:10px; font-weight:var(--fw-semibold); background:<%= rs[:bg] %>; color:<%= rs[:color] %>; padding:3px 10px; border-radius:999px; text-transform:uppercase; letter-spacing:0.05em;">
                <%= rs[:label] %>
              </span>
            </td>
            <td style="padding:var(--space-3) var(--space-4); text-align:right;">
              <div class="flex gap-2" style="justify-content:flex-end; align-items:center;">
                <% unless reg.confirmed? %>
                  <%= button_to "Confirmer",
                    admin_camp_registration_path(@camp, reg),
                    params: { registration: { status: "confirmed" } },
                    method: :patch,
                    class: "ds-btn ds-btn--sm",
                    style: "background:var(--growth-600);color:white;border-color:var(--growth-600);" %>
                <% end %>
                <% unless reg.cancelled? %>
                  <%= button_to "Annuler",
                    admin_camp_registration_path(@camp, reg),
                    params: { registration: { status: "cancelled" } },
                    method: :patch,
                    class: "ds-btn ds-btn--sm",
                    style: "background:var(--error-50);color:var(--error-700);border:1px solid var(--error-200);" %>
                <% end %>
                <% if reg.cancelled? %>
                  <%= button_to "Remettre en attente",
                    admin_camp_registration_path(@camp, reg),
                    params: { registration: { status: "pending" } },
                    method: :patch,
                    class: "ds-btn ds-btn--outline ds-btn--sm" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @registrations.empty? %>
          <tr>
            <td colspan="5" style="padding:var(--space-8); text-align:center; color:var(--neutral-400);">Aucune inscription pour ce camp.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
