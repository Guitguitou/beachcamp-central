<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Admin — BeachCamp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="icon" href="/icon.png" type="image/png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      .admin-sidebar {
        width: 240px;
        min-height: 100vh;
        background: var(--neutral-900);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
      }
      .admin-sidebar__brand {
        padding: var(--space-5) var(--space-5) var(--space-4);
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }
      .admin-sidebar__brand-name {
        font-size: 1.1rem;
        font-weight: var(--fw-extrabold);
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .admin-sidebar__brand-label {
        font-size: var(--fs-xs);
        color: var(--neutral-500);
        margin-top: 2px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .admin-sidebar__nav {
        flex: 1;
        padding: var(--space-4) var(--space-3);
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .admin-sidebar__section-label {
        font-size: 10px;
        font-weight: var(--fw-semibold);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--neutral-600);
        padding: var(--space-3) var(--space-3) var(--space-1);
        margin-top: var(--space-2);
      }
      .admin-sidebar__link {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-md);
        font-size: var(--fs-sm);
        font-weight: var(--fw-medium);
        color: var(--neutral-400);
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
      }
      .admin-sidebar__link:hover {
        background: rgba(255,255,255,0.06);
        color: white;
      }
      .admin-sidebar__link--active {
        background: rgba(255,255,255,0.1);
        color: white;
      }
      .admin-sidebar__link-icon {
        width: 20px;
        text-align: center;
        font-size: 1rem;
        flex-shrink: 0;
      }
      .admin-sidebar__footer {
        padding: var(--space-4) var(--space-3);
        border-top: 1px solid rgba(255,255,255,0.08);
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .admin-layout {
        display: flex;
        min-height: 100vh;
        background: var(--neutral-50);
      }
      .admin-main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .admin-topbar {
        background: white;
        border-bottom: 1px solid var(--neutral-200);
        padding: var(--space-3) var(--space-6);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-shrink: 0;
      }
      .admin-topbar__breadcrumb {
        font-size: var(--fs-sm);
        color: var(--neutral-500);
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .admin-topbar__user {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        font-size: var(--fs-sm);
      }
      .admin-content {
        flex: 1;
        padding: var(--space-6) var(--space-8);
        max-width: 1200px;
        width: 100%;
      }
      .admin-flash {
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-md);
        font-size: var(--fs-sm);
        margin-bottom: var(--space-4);
      }
      .admin-flash--notice {
        background: var(--growth-50);
        color: var(--growth-800);
        border: 1px solid var(--growth-200);
      }
      .admin-flash--alert {
        background: var(--error-50);
        color: var(--error-800);
        border: 1px solid var(--error-200);
      }
    </style>
  </head>

  <body style="margin:0;">
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <div class="admin-sidebar__brand">
          <a href="<%= root_path %>" class="admin-sidebar__brand-name">
            🏐 <span style="color:var(--sunset-400);">BeachCamp</span>
          </a>
          <div class="admin-sidebar__brand-label">Administration</div>
        </div>

        <nav class="admin-sidebar__nav">
          <div class="admin-sidebar__section-label">Vue d'ensemble</div>

          <%= link_to admin_dashboard_path, class: "admin-sidebar__link #{request.path.include?('dashboard') ? 'admin-sidebar__link--active' : ''}" do %>
            <span class="admin-sidebar__link-icon">🏠</span> Dashboard
          <% end %>

          <div class="admin-sidebar__section-label">Gestion</div>

          <%= link_to admin_users_path, class: "admin-sidebar__link #{request.path.match?(%r{/admin/users}) ? 'admin-sidebar__link--active' : ''}" do %>
            <span class="admin-sidebar__link-icon">👥</span> Utilisateurs
          <% end %>

          <%= link_to admin_camps_path, class: "admin-sidebar__link #{request.path.match?(%r{/admin/camps}) ? 'admin-sidebar__link--active' : ''}" do %>
            <span class="admin-sidebar__link-icon">🏕️</span> Camps
          <% end %>

          <div class="admin-sidebar__section-label">Accès rapide</div>

          <%= link_to new_admin_user_path, class: "admin-sidebar__link" do %>
            <span class="admin-sidebar__link-icon">➕</span> Créer un utilisateur
          <% end %>

          <%= link_to new_admin_camp_path, class: "admin-sidebar__link" do %>
            <span class="admin-sidebar__link-icon">➕</span> Créer un camp
          <% end %>
        </nav>

        <div class="admin-sidebar__footer">
          <%= link_to root_path, class: "admin-sidebar__link" do %>
            <span class="admin-sidebar__link-icon">↗️</span> Site public
          <% end %>
          <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "admin-sidebar__link" do %>
            <span class="admin-sidebar__link-icon">🚪</span> Déconnexion
          <% end %>
        </div>
      </aside>

      <div class="admin-main">
        <div class="admin-topbar">
          <div class="admin-topbar__breadcrumb">
            Admin
            <% if content_for?(:breadcrumb) %>
              <span style="color:var(--neutral-300);">/</span>
              <%= yield :breadcrumb %>
            <% end %>
          </div>
          <div class="admin-topbar__user">
            <div style="width:32px;height:32px;background:var(--gradient-sunset);border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:var(--fs-xs);font-weight:var(--fw-bold);">
              <%= current_user.first_name[0] %><%= current_user.last_name[0] %>
            </div>
            <span style="color:var(--neutral-700); font-weight:var(--fw-medium);"><%= current_user.full_name %></span>
          </div>
        </div>

        <div style="padding: var(--space-4) var(--space-8) 0;">
          <% if notice.present? %>
            <div class="admin-flash admin-flash--notice"><%= notice %></div>
          <% end %>
          <% if alert.present? %>
            <div class="admin-flash admin-flash--alert"><%= alert %></div>
          <% end %>
        </div>

        <div class="admin-content">
          <%= yield %>
        </div>
      </div>
    </div>
  </body>
</html>
